#!/usr/bin/env python3
"""Fake Codex CLI for tests (`codex exec --json` subset)."""
import json
import sys


def out(obj):
    print(json.dumps(obj), flush=True)


args = sys.argv[1:]
if "--version" in args:
    print("codex-cli 0.0.0-fake")
    sys.exit(0)
prompt = sys.stdin.read() if args and args[-1] == "-" else ""
out({"type": "thread.started", "thread_id": "thread-abc"})
out({"type": "turn.started"})
out({"type": "item.started", "item": {"id": "i1", "type": "command_execution", "command": "pytest -q"}})
out({"type": "item.completed", "item": {"id": "i1", "type": "command_execution", "command": "pytest -q", "exit_code": 0}})
out({"type": "item.completed", "item": {"id": "i2", "type": "file_change", "changes": [{"path": "a.py", "kind": "update"}]}})
out({"type": "item.completed", "item": {"id": "i3", "type": "agent_message", "text": f"codex did: {prompt[:40]}"}})
out({"type": "turn.completed", "usage": {"input_tokens": 300, "cached_input_tokens": 50, "output_tokens": 40}})
