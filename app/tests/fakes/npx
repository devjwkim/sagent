                         "attachments": [{"name": "screenshot", "contentType": "image/png", "path": os.path.abspath(shot)}]}]}]},
    ], "suites": [{"title": "nested", "specs": [
        {"title": "logout", "tests": [{"projectName": "chromium", "status": "expected",
            "results": [{"status": "passed", "duration": 50}]}]}]}]}],
}
with open(os.environ["PLAYWRIGHT_JSON_OUTPUT_NAME"], "w") as fh:
    json.dump(report, fh)
rep = os.environ["PLAYWRIGHT_HTML_REPORT"]
os.makedirs(rep, exist_ok=True)
with open(os.path.join(rep, "index.html"), "w") as fh:
    fh.write("<html><script>window.x=1</script><body>Playwright report</body></html>")
