#!/usr/bin/env python3
"""Fake `npx playwright test` writing the JSON + HTML reporters' output."""
import json
import os
import sys

args = sys.argv[1:]
if args[:2] != ["playwright", "test"]:
    print("fake npx: unsupported", args)
    sys.exit(2)
out = next((a.split("=", 1)[1] for a in args if a.startswith("--output=")), "test-results")
os.makedirs(out, exist_ok=True)
shot = os.path.join(out, "checkout-failed-1.png")
